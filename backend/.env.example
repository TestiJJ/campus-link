# CampusLink Backend Environment Variables

# 1. Cloudinary Permanent Cloud Storage (Images, Videos, Reels, Status Stories, Voice Notes)
# Get your free credentials from https://cloudinary.com (Dashboard -> API Keys):
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
# Or configure separately:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# 2. Email Verification Service (Bypasses cloud host SMTP port blocks)
# Free 3,000 emails/month from https://resend.com (Recommended for Render):
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=CampusLink <onboarding@resend.dev>

# Alternative: Brevo (formerly Sendinblue) free 300 emails/day:
# BREVO_API_KEY=xkeysib-your_brevo_api_key

# 3. Fallback Gmail SMTP (Only works on hosts allowing port 465/587)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# 4. Database Connection (PostgreSQL or SQLite)
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<dbname>?sslmode=require

# 5. Security & Authentication Keys
# Generate a 64-char random hex key using: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_key_here
# Secret key required to register as platform admin
ADMIN_SECURITY_KEY=generate_a_strong_admin_key_here

# 6. Deployment & Host URLs
BACKEND_URL=https://campuslink-backend.onrender.com
FRONTEND_URL=https://campus-link.com.ng
